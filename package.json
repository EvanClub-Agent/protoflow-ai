{
  "name": "alex",
  "private": true,
  "version": "0.0.7",
  "license": "Apache-2.0",
  "description": "Alex (ProtoFlow AI) — AI 原型设计、ER 数据建模与多端协同工作台",
  "author": {
    "name": "EvanJiao",
    "email": "ai.agent.club@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EvanClub-Agent/protoflow-ai.git"
  },
  "homepage": "https://alex.xclubai.com",
  "desktopName": "protoflow-ai.desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:unpacked": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "build:mac:arm64": "npm run build:mac -- --arm64",
    "build:mac:x64": "npm run build:mac -- --x64",
    "build:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux --x64 --publish never",
    "build:linux:deb": "npm run build && electron-builder --config electron-builder.config.cjs --linux deb --x64 --publish never",
    "test": "node scripts/test.cjs",
    "test:package": "node scripts/desktop-package-smoke.cjs",
    "test:linux-icons": "python3 scripts/linux-icon-smoke.py",
    "test:desktop-authoring": "npm run build && node scripts/desktop-authoring-smoke.cjs",
    "test:persistence": "node scripts/project-persistence-smoke.cjs",
    "test:hermes": "node scripts/hermes-smoke.cjs",
    "test:hermes-images": "node scripts/hermes-image-smoke.cjs",
    "test:hermes-management": "node scripts/hermes-management-smoke.cjs",
    "build:viewer": "tsc -b && vite build --mode viewer",
    "server:dev": "node scripts/run-publish-server.cjs",
    "server:test": "cd server && go test ./...",
    "server:create-publisher": "node scripts/run-publish-server.cjs create-publisher",
    "server:create-admin": "node scripts/run-publish-server.cjs create-admin",
    "test:publishing": "node scripts/publishing-smoke.cjs",
    "test:materials": "npm run build && node scripts/materials-smoke.cjs",
    "test:freeform": "npm run build && node scripts/freeform-smoke.cjs",
    "test:charts": "npm run build && node scripts/charts-smoke.cjs",
    "test:charts-ai": "npm run build:contracts && node scripts/hermes-smoke.cjs --charts",
    "test:table-ai": "npm run build:contracts && node scripts/hermes-smoke.cjs --table",
    "test:ai-implementation": "npm run build && node scripts/hermes-smoke.cjs --custom",
    "test:streaming": "npm run build && node scripts/streaming-smoke.cjs",
    "test:project-ai-live": "npm run build && node scripts/project-ai-live-smoke.cjs",
    "test:sitemap-navigation": "npm run build && node scripts/sitemap-navigation-smoke.cjs",
    "test:database-diagram": "npm run build && node scripts/database-diagram-smoke.cjs",
    "test:mindmap": "npm run build && node scripts/mindmap-smoke.cjs",
    "test:hermes-mindmap": "npm run build:contracts && node scripts/hermes-mindmap-smoke.cjs",
    "test:query-layout": "npm run build && node scripts/query-layout-smoke.cjs",
    "test:grid-layout": "npm run build && node scripts/grid-layout-smoke.cjs",
    "build:integrations": "npm run build:contracts && node scripts/build-client-integrations.cjs",
    "build:contracts": "node scripts/build-material-contract.cjs",
    "predev": "npm run build:contracts",
    "prebuild": "npm run build:contracts",
    "prebuild:viewer": "npm run build:contracts",
    "preelectron:start": "npm run build:contracts",
    "pretest:hermes": "npm run build:contracts",
    "pretest:hermes-images": "npm run build:contracts",
    "pretest:hermes-management": "npm run build:contracts",
    "test:project-truth": "npm run build && node scripts/project-truth-smoke.cjs",
    "test:mermaid-diagrams": "node scripts/mermaid-diagrams-smoke.cjs",
    "test:note-assistant": "npm run build && node scripts/note-assistant-smoke.cjs",
    "website:sync": "node scripts/website-sync-downloads.cjs",
    "website:seo": "node scripts/website-build-seo.cjs",
    "website:preview": "python3 -m http.server 4173 --directory website"
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.8",
    "@babel/standalone": "^8.0.10",
    "@babel/types": "^8.0.8",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "antd": "^6.6.8",
    "dayjs": "^1.11.23",
    "echarts": "6.1.0",
    "lossless-json": "4.3.4",
    "lucide-react": "^0.468.0",
    "mermaid": "12.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "fflate": "0.8.2",
    "jsdom": "^26.1.0",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "productName": "Alex"
}
