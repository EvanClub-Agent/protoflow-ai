DATABASE_URL=postgresql://protoflow:replace-with-database-password@localhost:5432/protoflow_publish?sslmode=disable
PUBLIC_ORIGIN=http://localhost:8088
LISTEN_ADDR=127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RELEASE_STORAGE_DIR=./data/releases

# Optional HTTP admin LAN allowlist (empty keeps HTTPS/loopback only).
ADMIN_HTTP_ALLOWED_CIDRS=
